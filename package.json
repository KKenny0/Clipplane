{
  "name": "clipplane",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser clipper that saves web pages and selections into an org-mode inbox.",
  "scripts": {
    "test": "node --test",
    "prepare:extension": "node scripts/prepare-extension-vendor.mjs",
    "postinstall": "npm run prepare:extension",
    "doctor": "node scripts/doctor.mjs",
    "doctor:native:chrome": "pwsh -NoLogo -NoProfile -File scripts/check-native-host.ps1 -Browser chrome",
    "doctor:native:edge": "pwsh -NoLogo -NoProfile -File scripts/check-native-host.ps1 -Browser edge",
    "setup:windows:chrome": "pwsh -NoLogo -NoProfile -File scripts/setup-windows.ps1 -Browser chrome",
    "setup:windows:edge": "pwsh -NoLogo -NoProfile -File scripts/setup-windows.ps1 -Browser edge",
    "setup:macos:chrome": "bash scripts/setup-macos.sh --browser chrome",
    "setup:macos:edge": "bash scripts/setup-macos.sh --browser edge",
    "doctor:native:macos:chrome": "bash scripts/check-native-host-macos.sh --browser chrome",
    "doctor:native:macos:edge": "bash scripts/check-native-host-macos.sh --browser edge",
    "smoke": "node scripts/smoke-clip.mjs",
    "package:extension": "npm run prepare:extension && node scripts/package-extension.mjs",
    "smoke:sync:local": "node scripts/smoke-sync-local.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@mozilla/readability": "0.6.0",
    "jsdom": "29.1.1"
  },
  "dependencies": {
    "cross-keychain": "1.1.0"
  }
}
