{
  "manifest_version": 3,
  "name": "Clipplane",
  "version": "0.3.2",
  "description": "Save the current page or selected text into a local org-mode inbox.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to Clipplane"
  },
  "options_page": "settings.html"
}
